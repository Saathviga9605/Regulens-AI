# ReguLens AI — development configuration.
# Copy to .env in this directory (repository root). Both apps read this file:
#   backend  -> REGULENS_* variables (via pydantic-settings)
#   frontend -> VITE_* variables (Vite envDir is the repo root)
# Never commit .env. No secrets are required for this deliverable.

# --- Backend ---------------------------------------------------------------
# development | test | staging | production  (production disables /docs and forbids "*" CORS)
REGULENS_ENVIRONMENT=development
REGULENS_HOST=127.0.0.1
REGULENS_PORT=8000
REGULENS_API_PREFIX=/api/v1
REGULENS_API_VERSION=v1
REGULENS_LOG_LEVEL=INFO

# SQLite database. Relative paths resolve against the repository root.
# The parent directory is created automatically.
REGULENS_DATABASE_URL=sqlite:///data/regulens.db

# Comma-separated list of allowed frontend origins (exact match, no wildcard).
REGULENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private document storage (uploaded PDFs). Relative paths resolve against the repo root.
# Must not be inside frontend/ (rejected at startup). Never served as static files; git-ignored.
REGULENS_DOCUMENT_STORAGE_DIR=data/documents
# Maximum PDF upload size in bytes (default 20 MiB; allowed 1024 - 209715200). Only PDF is accepted.
REGULENS_MAX_UPLOAD_BYTES=20971520

# Document processing / OCR. OCR is optional: without Tesseract, image-only pages are reported as unreadable.
# Empty = auto-detect `tesseract` on PATH or C:\Program Files\Tesseract-OCR\tesseract.exe
REGULENS_TESSERACT_CMD=
REGULENS_OCR_ENABLED=true
# Local OCR provider: auto (Tesseract if found, else RapidOCR if installed), tesseract, rapidocr or none
REGULENS_OCR_ENGINE=auto
REGULENS_OCR_LANGUAGE=eng
REGULENS_OCR_DPI=200
REGULENS_OCR_TIMEOUT_SECONDS=30
# Pages with fewer non-whitespace characters than this in the text layer are OCR candidates.
REGULENS_MIN_PAGE_TEXT_CHARS=25
REGULENS_MAX_PROCESSING_PAGES=50

# Local prototype authentication (see docs/security.md). Sessions expire after this many minutes.
REGULENS_SESSION_TTL_MINUTES=480
REGULENS_LOGIN_MAX_FAILURES=5
REGULENS_LOGIN_LOCKOUT_MINUTES=15
# Demo accounts — LOCAL DEMO ONLY — CHANGE BEFORE SHARING.
# Created/reconciled by `python -m app.cli seed` (and `create-demo-users`). Idempotent: only these two usernames are
# touched; passwords are stored as scrypt hashes only and never logged. These values are also the built-in defaults,
# so a .env without them behaves the same. Must be false (and is enforced) when REGULENS_ENVIRONMENT=production.
REGULENS_DEMO_USERS_ENABLED=true
REGULENS_DEMO_REVIEWER_USERNAME=demo.reviewer
REGULENS_DEMO_REVIEWER_PASSWORD=Reviewer@Demo2026
REGULENS_DEMO_ADMIN_USERNAME=demo.admin
REGULENS_DEMO_ADMIN_PASSWORD=Admin@Demo2026

# --- Frontend --------------------------------------------------------------
# Base URL of the backend API, including the version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
